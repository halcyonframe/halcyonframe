CONFIG_IDF_TARGET="esp32s3"

# Board: 16 MB flash, 8 MB octal PSRAM (matches the Waveshare reference sdkconfig)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Long filenames on the TF card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Uploads send a few hundred KB; larger headers for modern browsers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# A new firmware must confirm it works (ota_mark_good) before its first reset, else the bootloader goes
# back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Power: the bootloader would otherwise SHA-256 the whole ~2 MB app on every deep-sleep wake. Images are
# still verified on normal boots and when an update is installed.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# Release builds: smaller and faster to wake than the default debug optimisation.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
